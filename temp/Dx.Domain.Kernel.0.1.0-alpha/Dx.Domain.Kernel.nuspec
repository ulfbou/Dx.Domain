    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Dx.Domain.Annotations" version="0.1.0-alpha" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Dx.Domain.Annotations" version="0.1.0-alpha" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Dx.Domain.Annotations" version="0.1.0-alpha" exclude="Build,Analyzers" />
