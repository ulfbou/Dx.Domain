<?xml version="1.0" encoding="utf-8"?>
<Project>
  
  <!--
    Dx.Domain.Annotations.targets
    
    Enforces Dx.Domain analyzer policies at build time (same as Dx.Domain.targets).
    This ensures enforcement even when only Annotations is referenced.
  -->

  <Target Name="DxEnforceAnalyzers" BeforeTargets="CoreCompile">
    <Message Text="Dx.Domain.Annotations: Enforcing analyzer policies..." Importance="high" />
    
    <!-- HARD FAIL: Analyzers cannot be disabled -->
    <Error
      Condition="'$(RunAnalyzers)' == 'false'"
      Text="Dx.Domain analyzers cannot be disabled. Remove RunAnalyzers=false from your project or build configuration."
      Code="DXB001" />
    
    <Error
      Condition="'$(EnableNETAnalyzers)' == 'false'"
      Text="NET analyzers must be enabled for Dx.Domain enforcement. Remove EnableNETAnalyzers=false from your project or build configuration."
      Code="DXB002" />
    
    <!-- Check for .editorconfig attempts to override Dx diagnostics -->
    <ItemGroup>
      <_DxEditorConfigs Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.editorconfig'" />
    </ItemGroup>
    
    <ReadLinesFromFile File="@(_DxEditorConfigs)" Condition="'@(_DxEditorConfigs)' != ''">
      <Output TaskParameter="Lines" ItemName="_DxEditorConfigLines"/>
    </ReadLinesFromFile>
    
    <Error
      Condition="$([System.String]::new('%(_DxEditorConfigLines.Identity)')).Contains('dotnet_diagnostic.DXA')"
      Text="Dx.Domain diagnostics cannot be configured via .editorconfig. Remove all 'dotnet_diagnostic.DXA*' entries. Detected in: @(_DxEditorConfigs)"
      Code="DXB003" />
    
    <Message
      Text="Dx.Domain.Annotations: Analyzer enforcement complete. All policies active."
      Importance="high" />
  </Target>

  <PropertyGroup Label="Dx.Domain Diagnostics as Errors">
    <!-- Treat all Dx diagnostics as errors (non-negotiable) -->
    <WarningsAsErrors>$(WarningsAsErrors);DXA010;DXA011;DXA020;DXA022;DXA030;DXA040;DXA050;DXA060;DXA070;DXA080;DXA090</WarningsAsErrors>
  </PropertyGroup>

</Project>
