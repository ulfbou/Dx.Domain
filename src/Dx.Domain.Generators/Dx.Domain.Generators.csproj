<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DxIsLibrary>true</DxIsLibrary>
    <DxLayer>Authority</DxLayer>

    <RootNamespace>Dx.Domain.Generators</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Description>
      Source generators for Dx.Domain. It shifts metadata management from an
      imperative process to a simple, declarative one.
    </Description>
    <PackageTags>dx;ddd;source-generators;result-pattern</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <DxProjectKind Include="true" Condition="'$(DxIsLibrary)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dx.Domain.Annotations" />
    <InternalsVisibleTo Include="Dx.Domain.Analyzers" />
    <InternalsVisibleTo Include="Dx.Domain.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dx.Domain.Kernel\Dx.Domain.Kernel.csproj" />
    <ProjectReference Include="..\Dx.Domain.Facts\Dx.Domain.Facts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dx.Domain.Annotations\Dx.Domain.Annotations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <Import Project="Directory.Pack.props" Condition="Exists('Directory.Pack.props')" />
</Project>
