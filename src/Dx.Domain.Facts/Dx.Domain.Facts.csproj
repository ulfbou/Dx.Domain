<Project Sdk="Microsoft.NET.Sdk" Label="Dx.Domain.Facts">
  <PropertyGroup>
    <DxIsLibrary>true</DxIsLibrary>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <DxProjectKind Include="true" Condition="'$(DxIsLibrary)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the analyzer so consumers get rules automatically -->
    <None Include="..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll"
          Condition="Exists('..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll')"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dx.Domain.Kernel\Dx.Domain.Kernel.csproj" />
    <ProjectReference Include="..\Dx.Domain.Primitives\Dx.Domain.Primitives.csproj" />
    <ProjectReference Include="..\Dx.Domain.Annotations\Dx.Domain.Annotations.csproj" />
  </ItemGroup>
</Project>
