<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DxIsLibrary>true</DxIsLibrary>
    <DxLayer>Primitives</DxLayer>
    <AssemblyName>Dx.Domain.Primitives</AssemblyName>
    <RootNamespace>Dx.Domain.Primitives</RootNamespace>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>
      The Dx.Domain.Primitives package provides low-level primitives for domain modeling and observability.
    </Description>
    <PackageTags>dx;ddd;primitives;actor-id;fact-id;correlation-id;trace-id;span-id;observability</PackageTags>
    <Authors>Dx.Domain Team</Authors>
    <Company>Dx.Domain Team</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;DX1001</NoWarn>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/dx.domain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ulfbou/dx.domain</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0-alpha</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/Dx.Domain</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DxLayer" />
  </ItemGroup>
  <ItemGroup>
    <DxProjectKind Include="true" Condition="'$(DxIsLibrary)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll"
          Condition="Exists('..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll')"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="CHANGELOG.md" Link="docs/CHANGELOG.md" />
    <None Update="README.md" Link="docs/README.md" />
    <None Update="..\..\LICENSE" Link="docs/LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dx.Domain.Annotations\Dx.Domain.Annotations.csproj" />
  </ItemGroup>
</Project>
