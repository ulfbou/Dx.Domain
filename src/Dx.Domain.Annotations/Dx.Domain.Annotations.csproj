<Project Sdk="Microsoft.NET.Sdk" Label="Dx.Domain.Annotations">
  <PropertyGroup>
    <DxIsLibrary>true</DxIsLibrary>
    <DxLayer>Annotations</DxLayer>
    <AssemblyName>Dx.Domain.Annotations</AssemblyName>
    <RootNamespace>Dx.Domain.Annotations</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Description>Marker-only annotations for Dx.Domain (pure attributes). No runtime behavior.</Description>
    <PackageTags>dx;ddd;annotations;attributes;domain-model</PackageTags>
    <Authors>Dx.Domain Team</Authors>
    <Company>Dx.Domain Team</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/dx.domain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ulfbou/dx.domain</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DxLayer" />
  </ItemGroup>

  <ItemGroup>
    <DxProjectKind Include="true" Condition="'$(DxIsLibrary)' == 'true'" />
  </ItemGroup>


  <ItemGroup>
    <!-- Embed Dx.Domain.Analyzers so consumers get rules automatically -->
    <None Include="..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll"
          Condition="Exists('..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll')"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CHANGELOG.md" Link="docs/CHANGELOG.md" />
    <None Update="README.md"     Link="docs/README.md" />
    <None Update="..\..\LICENSE" Link="docs/LICENSE" />
  </ItemGroup>
</Project>
