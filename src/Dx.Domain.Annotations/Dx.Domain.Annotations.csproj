<!-- Dx.Domain.Annotations (formerly Abstractions) Project File -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DxIsLibrary>true</DxIsLibrary>

    <AssemblyName>Dx.Domain.Annotations</AssemblyName>
    <RootNamespace>Dx.Domain.Annotations</RootNamespace>

    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>

    <Description>
      Marker-only annotations for Dx.Domain (pure attributes). No runtime behavior.
      Usage is enforced by analyzers and generators; composition is by namespaces only.
    </Description>
    <PackageTags>dx;ddd;annotations;attributes;domain-model</PackageTags>
    <Authors>Dx.Domain Team</Authors>
    <Company>Dx.Domain Team</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/dx.domain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ulfbou/dx.domain</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\Dx.Domain.Annotations.targets" Pack="true" PackagePath="buildTransitive" />
    <None Update="CHANGELOG.md" Link="docs/CHANGELOG.md" />
    <None Update="README.md"     Link="docs/README.md" />
    <None Update="../../LICENSE" Link="docs/LICENSE" />
  </ItemGroup>

</Project>
