<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Dx.Domain.Annotations">
    <DxIsLibrary>true</DxIsLibrary>
    <DxLayer>Annotations</DxLayer>
    <AssemblyName>Dx.Domain.Annotations</AssemblyName>
    <RootNamespace>Dx.Domain.Annotations</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Description>Semantic vocabulary for Dx.Domain (pure metadata: markers, attributes, canon).</Description>
    <PackageTags>dx;ddd;annotations;attributes;domain-model</PackageTags>
    <Authors>Dx.Domain Team</Authors>
    <Company>Dx.Domain Team</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--<NoWarn>$(NoWarn);CS1591</NoWarn>-->
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/dx.domain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ulfbou/dx.domain</PackageProjectUrl>
    <Version>0.1.0-alpha</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0-alpha</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/Dx.Domain</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DxLayer" />
  </ItemGroup>

  <ItemGroup>
    <DxProjectKind Include="true" Condition="'$(DxIsLibrary)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll" Condition="Exists('..\Dx.Domain.Analyzers\bin\$(Configuration)\netstandard2.0\Dx.Domain.Analyzers.dll')" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Update="..\..\LICENSE" Link="docs/LICENSE" />
  </ItemGroup>
</Project>
