<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DxIsLibrary>true</DxIsLibrary>
    <DxLayer>Annotations</DxLayer>
    <AssemblyName>Dx.Domain.Annotations</AssemblyName>
    <RootNamespace>Dx.Domain.Annotations</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Description>Semantic vocabulary for Dx.Domain (pure metadata: markers, attributes, canon).</Description>
    <PackageTags>dx;ddd;annotations;attributes;domain-model</PackageTags>
    <Authors>Dx.Domain Team</Authors>
    <Company>Dx.Domain Team</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulfbou/dx.domain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ulfbou/dx.domain</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DxLayer" />
  </ItemGroup>

  <ItemGroup>
    <DxProjectKind Include="true" Condition="'$(DxIsLibrary)' == 'true'" />
  </ItemGroup>

  <Target Name="DxAnnotationXmlDocLint" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_DxAnnotationFiles Include="@(Compile)" Exclude="**\obj\**" />
    </ItemGroup>
    <ReadLinesFromFile File="%(_DxAnnotationFiles.Identity)">
      <Output TaskParameter="Lines" ItemName="_DxAnnotationLines" />
    </ReadLinesFromFile>
    <Error Code="DXB010"
           Text="[Dx Docs] XML &lt;code&gt; blocks must use CDATA in annotations."
           Condition="@(_DxAnnotationLines->Contains('&lt;code&gt;')) and !(@(_DxAnnotationLines->Contains('&lt;code&gt;&lt;![CDATA[')))" />
  </Target>


  <ItemGroup>
    <None Update="CHANGELOG.md" Link="docs/CHANGELOG.md" />
    <None Update="README.md"     Link="docs/README.md" />
    <None Update="..\..\LICENSE" Link="docs/LICENSE" />
  </ItemGroup>
</Project>
