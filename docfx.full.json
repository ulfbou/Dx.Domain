{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.md", "**/*.yml" ],
        "src": "docs/public"
      },
      {
        "files": [ "**/*.md", "**/*.yml" ],
        "src": "docs/internal"
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "**/bin/**", "**/obj/**" ]
      },
      { "files": [ "docs/images/**" ] }
    ],
    "dest": "_site",
    "template": [ "default" ],
    "globalMetadata": {
      "_appTitle": "Dx.Domain Documentation",
      "_appName": "Dx.Domain",
      "_appFooter": "Copyright 2025 Dx.Domain contributors",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_disableAffix": false,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/ulfbou/dx.domain",
        "branch": "main"
      },
      "_gitUrlPattern": "github",
      "_customMetadata": {
        "company": "Dx.Domain contributors",
        "version": "1.0.0",
          "framework": "net8.0;net9.0;net10.0"
      }
    },
    "fileMetadata": {
      "_tocTitle": {
        "api/**.yml": "API Reference"
      },
      "_tocRel": {
        "api/**.md": "../toc.yml"
      }
    },
    "markdownEngineName": "markdig",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "abbreviations",
        "autoidentifiers",
        "citations",
        "customcontainers",
        "definitionlists",
        "emphasisextras",
        "figures",
        "footers",
        "footnotes",
        "gridtables",
        "mathematics",
        "medialinks",
        "pipetables",
        "listextras",
        "tasklists",
        "diagrams",
        "autolinks",
        "attributes"
      ]
    }
  },
  "serve": {
    "port": 8080
  }
}
