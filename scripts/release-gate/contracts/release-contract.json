{
  "schema": "dx-domain.release-contract.v1",
  "version": "0.1.0-alpha",
  "tag": "v0.1.0-alpha",
  "solution": "Dx.Domain.sln",
  "required_sdk_majors": [
    8,
    9,
    10
  ],
  "package_ids": [
    "Dx.Domain.Annotations",
    "Dx.Domain.Kernel",
    "Dx.Domain.Primitives",
    "Dx.Domain.Facts"
  ],
  "prohibited_standalone_packages": [
    "Dx.Domain.Analyzers",
    "Dx.Domain.Generators"
  ],
  "analyzer_asset_path": "analyzers/dotnet/cs/Dx.Domain.Analyzers.dll",
  "strict_properties": {
    "Configuration": "Release",
    "TreatWarningsAsErrors": "true",
    "ContinuousIntegrationBuild": "true"
  },
  "generated_locations": [
    "src/**/bin",
    "src/**/obj",
    "tests/**/bin",
    "tests/**/obj",
    "TestResults",
    "artifacts",
    "_site"
  ]
}
