<Project>
  <!-- Root targets conductor. Imports only targets-stage assets after project evaluation. -->
  <Import Project="$(DxBuildRoot)identity/Dx.ResolveIdentity.targets"
          Condition="Exists('$(DxBuildRoot)identity/Dx.ResolveIdentity.targets')" />
  <Import Project="$(DxBuildRoot)policy/Dx.Governance.targets"
          Condition="Exists('$(DxBuildRoot)policy/Dx.Governance.targets')" />
</Project>