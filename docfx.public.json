{
  "build": {
    "content": [
      {
        "src": "docs",
        "files": ["**/*.md", "**/*.yml"],
        "exclude": ["internal/**", ".generated/**", "public/toc.yml", "learn/**/toc.yml", "adr/toc.yml", "analyzers/toc.yml"]
      }
    ],
    "resource": [
      { "files": ["images/**"], "src": "docs" }
    ],
    "dest": "_site",
    "template": ["default"],
    "globalMetadata": {
      "_appTitle": "Dx.Domain",
      "_appName": "Dx.Domain",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/ulfbou/dx.domain",
        "branch": "master"
      }
    }
  }
}
