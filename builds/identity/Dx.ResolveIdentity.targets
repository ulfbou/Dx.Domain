<Project>
  <!-- Resolves and freezes the declared architectural role before governance executes. -->
  <Target Name="DxResolveIdentity"
          BeforeTargets="DxValidateProjectIntent"
          Condition="'$(DxIdentityFrozen)' != 'true'">
    <PropertyGroup>
      <DxResolvedRole Condition="'$(DxIsLibrary)' == 'true'">RuntimeSubstrate</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsAnalyzer)' == 'true'">CompileTimeGovernance</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsAnnotations)' == 'true'">SemanticMetadata</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsTest)' == 'true'">Test</DxResolvedRole>
      <DxIdentityFrozen>true</DxIdentityFrozen>
    </PropertyGroup>

    <ItemGroup>
      <DxProjectKind Include="DxIsLibrary" Condition="'$(DxIsLibrary)' == 'true'" />
      <DxProjectKind Include="DxIsAnalyzer" Condition="'$(DxIsAnalyzer)' == 'true'" />
      <DxProjectKind Include="DxIsAnnotations" Condition="'$(DxIsAnnotations)' == 'true'" />
      <DxProjectKind Include="DxIsTest" Condition="'$(DxIsTest)' == 'true'" />
    </ItemGroup>
    
    <Message Importance="High"
             Condition="'$(DxResolvedRole)' != ''"
             Text="[Dx Identity] Resolved project role: $(DxResolvedRole)" />
  </Target>
</Project>
