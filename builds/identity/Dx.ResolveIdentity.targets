<Project Label="Dx.Identity.Resolve">
  <Target Name="DxResolveIdentity" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <DxResolvedRole Condition="'$(DxProjectRoleExplicit)' != ''">$(DxProjectRoleExplicit)</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxResolvedRole)' == '' AND '$(DxSdkHint)' != ''">$(DxSdkHint)</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxResolvedRole)' == '' AND '$(DxOutputTypeHint)' != ''">$(DxOutputTypeHint)</DxResolvedRole>
    </PropertyGroup>

    <Error Condition="'$(DxResolvedRole)' == ''"
           Code="DXB003"
           Text="[Dx Identity] Missing project identity. Define DxProjectRole in $(MSBuildProjectFile)." />

    <Message Importance="High" Text="[Dx Identity] Resolved role: $(DxResolvedRole)" />
  </Target>
</Project>
