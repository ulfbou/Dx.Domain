<Project Label="Dx.Identity.Resolve">
  <Target Name="DxResolveIdentity" BeforeTargets="DxEnforceIntentValidation">
    <PropertyGroup>
      <DxResolvedRole Condition="'$(DxIsLibrary)' == 'true'">Library</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsAbstractions)' == 'true'">Abstractions</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsAnalyzer)' == 'true'">Analyzer</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsTest)' == 'true'">Test</DxResolvedRole>
      <DxResolvedRole Condition="'$(DxIsTool)' == 'true'">Tool</DxResolvedRole>

      <DxIdentityFrozen>true</DxIdentityFrozen>
    </PropertyGroup>

    <Message Importance="High" Text="[Dx Identity] Project Intent Verified: $(DxResolvedRole)" Condition="'$(DxResolvedRole)' != ''" />
  </Target>
</Project>
