<Project Label="Dx.Policy.IntentValidation">

  <!-- Validation: exactly one role -->
  <Target Name="DxValidateProjectIntent" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_DxDeclaredKind Include="@(DxProjectKind)" />
    </ItemGroup>

    <Error Code="DX011"
           File="$(MSBuildProjectFullPath)"
           Condition="'@(_DxDeclaredKind->Count())' != '1'"
           Text="[Dx Intent] Exactly one project role must be declared." />
  </Target>

  <!-- Block hardcoded versions -->
  <Target Name="DxValidateNoHardcodedVersion"
        BeforeTargets="PrepareForBuild">

    <XmlPeek
        XmlInputPath="$(MSBuildProjectFullPath)"
        Query="/*[local-name()='Project']/*[local-name()='PropertyGroup']/*[local-name()='Version']">
      <Output TaskParameter="Result"
              ItemName="_DxVersionNodes" />
    </XmlPeek>

    <XmlPeek
        XmlInputPath="$(MSBuildProjectFullPath)"
        Query="/*[local-name()='Project']/*[local-name()='PropertyGroup']/*[local-name()='PackageVersion']">
      <Output TaskParameter="Result"
              ItemName="_DxPackageVersionNodes" />
    </XmlPeek>

    <Error
        Code="DX021"
        File="$(MSBuildProjectFullPath)"
        Condition="'@(_DxVersionNodes)' != '' Or '@(_DxPackageVersionNodes)' != ''"
        Text="[Dx Governance] Hardcoded version metadata is forbidden." />

  </Target>

  <!-- Role-derived defaults -->
  <Target Name="DxApplyRoleDefaults"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="DxValidateProjectIntent;DxValidateNoHardcodedVersion">

    <!-- Runtime -->
    <PropertyGroup Condition="'$(DxResolvedRole)' == 'RuntimeSubstrate'">
      <TargetFrameworks>$(DxRuntimeTargetFrameworks)</TargetFrameworks>
      <IsPackable>true</IsPackable>
      <IncludeBuildOutput>true</IncludeBuildOutput>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DxResolvedRole)' == 'CompileTimeGovernance'">
      <TargetFramework>$(DxHostCompatibleTargetFramework)</TargetFramework>
      <IsPackable>false</IsPackable>
      <IncludeBuildOutput>false</IncludeBuildOutput>
      <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <!-- Metadata -->
    <PropertyGroup Condition="'$(DxResolvedRole)' == 'SemanticMetadata'">
      <TargetFramework>$(DxUniversalMetadataTargetFramework)</TargetFramework>
      <IsPackable>true</IsPackable>
      <IncludeBuildOutput>true</IncludeBuildOutput>
    </PropertyGroup>

    <!-- Test (FULLY CENTRALIZED) -->
    <PropertyGroup Condition="'$(DxResolvedRole)' == 'Test'">
      <TargetFrameworks>$(DxTestTargetFrameworks)</TargetFrameworks>
      <IsPackable>false</IsPackable>
      <IsTestProject>true</IsTestProject>

      <GenerateDocumentationFile>false</GenerateDocumentationFile>
      <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
      <EnableNETAnalyzers>false</EnableNETAnalyzers>
      <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>

  </Target>

</Project>
