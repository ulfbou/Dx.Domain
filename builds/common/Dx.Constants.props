<Project>
  <!-- Unconditional repository constants only. No conditions, no policy logic, no role logic. -->
  <PropertyGroup Label="Dx.RepositoryMetadata">
    <DxCompany>Dx.Domain Team</DxCompany>
    <DxAuthors>Ulf Bourelius (Original Author);$(DxCompany)</DxAuthors>
    <DxRepositoryUrl>https://github.com/ulfbou/Dx.Domain.git</DxRepositoryUrl>
    <DxCopyright>Copyright © $([System.DateTime]::UtcNow.ToString('yyyy')) $(DxCompany). All rights reserved.</DxCopyright>
  </PropertyGroup>
</Project>
