<Project>

  <!-- Centralized defaults. Leaf projects declare exactly one role and do not set governed properties. -->
  <PropertyGroup Label="Dx.BuildDefaults">
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzers>true</RunAnalyzers>

    <ContinuousIntegrationBuild Condition="'$(CI)' != '' Or '$(TF_BUILD)' != ''">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <DxIdentityFrozen>false</DxIdentityFrozen>
  </PropertyGroup>

  <PropertyGroup Label="Dx.FrameworkStrategy">
    <DxRuntimeTargetFrameworks>net8.0;net9.0;net10.0</DxRuntimeTargetFrameworks>
    <DxHostCompatibleTargetFramework>netstandard2.0</DxHostCompatibleTargetFramework>
    <DxUniversalMetadataTargetFramework>netstandard2.0</DxUniversalMetadataTargetFramework>
    <DxTestTargetFrameworks>net10.0</DxTestTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Label="Dx.ToolchainStrategy">
    <DxRoslynCompilerVersion>5.3.0</DxRoslynCompilerVersion>
  </PropertyGroup>

  <PropertyGroup Label="Dx.RoleFlags">
    <DxIsLibrary Condition="'$(DxIsLibrary)' == ''">false</DxIsLibrary>
    <DxIsAnalyzer Condition="'$(DxIsAnalyzer)' == ''">false</DxIsAnalyzer>
    <DxIsAnnotations Condition="'$(DxIsAnnotations)' == ''">false</DxIsAnnotations>
    <DxIsTest Condition="'$(DxIsTest)' == ''">false</DxIsTest>
  </PropertyGroup>

  <PropertyGroup Label="Dx.PackageMetadataDefaults">
    <Authors Condition="'$(Authors)' == ''">$(DxAuthors)</Authors>
    <Company Condition="'$(Company)' == ''">$(DxCompany)</Company>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">$(DxRepositoryUrl)</RepositoryUrl>
    <Copyright Condition="'$(Copyright)' == ''">$(DxCopyright)</Copyright>
  </PropertyGroup>

  <ItemGroup Condition="!Exists('packages.config')">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset"
                      Version="$(DxRoslynCompilerVersion)"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers" />

    <PackageReference Include="Nerdbank.GitVersioning"
                      Version="3.9.50"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DxIsTest)' != 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);DXA*;DXK*;DXT*;DX100*;DX700*</WarningsAsErrors>
  </PropertyGroup>

</Project>
