{
  "metadata": [
    {
      "src": [
        {
          "files": [ "src/**/*.csproj" ],
          "exclude": [ "**/bin/**", "**/obj/**" ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },

      // PUBLIC docs only
      {
        "files": [ "docs/public/**.md", "docs/public/**/toc.yml" ],
        "exclude": [ "**/bin/**", "**/obj/**", "_site/**" ]
      },

      // Root-facing pages you want on the site
      { "files": [ "README.md", "CHANGELOG.md", "CONTRIBUTING.md" ] },

      // Optional: site-level markdown (home, overview)
      {
        "files": [ "toc.yml", "*.md" ],
        "exclude": [ "LICENSE", "obj/**", "_site/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "**/bin/**", "**/obj/**" ]
      },
      { "files": [ "docs/public/images/**" ] },
      {
        "files": [ "assets/**" ],
        "exclude": [ "**/bin/**", "**/obj/**" ]
      }
    ],
    "dest": "_site",
    "template": [ "default" ],
    "globalMetadata": {
      "_appTitle": "Dx.Domain Documentation",
      "_appName": "Dx.Domain",
      "_appFooter": "Copyright © 2026 Dx.Domain Team. All rights reserved.",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_disableAffix": false,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/ulfbou/Dx.Domain",
        "branch": "main"
      },
      "_gitUrlPattern": "github",
      "_customMetadata": {
        "company": "Dx.Domain Team",
        "version": "0.x",
        "framework": "net8.0;net9.0;net10.0"
      }
    },
    "fileMetadata": {
      "_tocTitle": { "api/**.yml": "API Reference" },
      "_tocRel": { "api/**.md": "../toc.yml" }
    },
    "markdownEngineName": "markdig",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "abbreviations",
        "autoidentifiers",
        "citations",
        "customcontainers",
        "definitionlists",
        "emphasisextras",
        "figures",
        "footers",
        "footnotes",
        "gridtables",
        "mathematics",
        "medialinks",
        "pipetables",
        "listextras",
        "tasklists",
        "diagrams",
        "autolinks",
        "attributes"
      ]
    }
  },
  "serve": { "port": 8080 }
}
